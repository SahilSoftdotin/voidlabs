# ---------------------------------------------------------------------------
# Resume Scoring & Candidate Triage — backend configuration
# Copy to `.env` and fill in. NEVER commit a real .env (see .gitignore).
# ---------------------------------------------------------------------------

# Database. Defaults to a local SQLite file for zero-config dev.
# For production use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/triage
DATABASE_URL=sqlite:///./storage/triage.db

# Where uploaded resume files are stored (original_file_ref points here).
STORAGE_DIR=./storage/uploads

# ---------------------------------------------------------------------------
# Scoring engine
# ---------------------------------------------------------------------------
# SCORING_BACKEND: auto | llm | mock
#   auto - use the LLM scorer when ANTHROPIC_API_KEY is set, else the mock.
#   llm  - always use the LLM scorer (errors if no key).
#   mock - deterministic, offline, explainable heuristic scorer (no API calls).
SCORING_BACKEND=auto

# Resume normalization backend: auto | llm | heuristic
RESUME_NORMALIZER=auto

# ---------------------------------------------------------------------------
# Anthropic / Claude — semantic skill matching + interview questions.
# Secret lives ONLY in the environment, never in code or git.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
